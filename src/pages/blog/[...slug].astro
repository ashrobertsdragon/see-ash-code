---
import { type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CopyCodeButton from '../../components/CopyCodeButton.astro';
import { getPublishedPosts, slugifyTag } from '../../utils/posts';
import { getReadingTime } from '../../utils/readingTime';
import { AUTHOR_NAME, SOCIAL_LINKS } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const readingTime = getReadingTime(post.body || '');

const formattedDate = new Date(post.data.published_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  articleDate={new Date(post.data.published_at).toISOString()}
  ogType="article"
>
  <article class="space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-muted-foreground">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:underline">Blog</a>
      <span>/</span>
      <span class="text-foreground line-clamp-1">{post.data.title}</span>
    </nav>

    <!-- Post Header -->
    <header class="space-y-4 border-b border-border/60 pb-8">
      <!-- Tags -->
      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${slugifyTag(tag)}`}
                class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-muted text-muted-foreground hover:bg-primary/10 hover:text-primary transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-foreground leading-[1.15]">
        {post.data.title}
      </h1>

      <div class="flex items-center gap-3 text-sm text-muted-foreground pt-1">
        <div class="flex items-center gap-2">
          <span class="font-medium text-foreground">{AUTHOR_NAME}</span>
        </div>
        <span>•</span>
        <time datetime={new Date(post.data.published_at).toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span>{readingTime}</span>
      </div>
    </header>

    <!-- Content & Sidebar Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Main Article Body -->
      <div class="lg:col-span-8 prose dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-img:rounded-xl prose-img:border prose-img:border-border prose-pre:rounded-xl prose-pre:border prose-pre:border-border/60">
        <Content />
      </div>

      <!-- Sticky Sidebar (TOC) -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-24 space-y-6">
        <TableOfContents headings={headings} />

        <div class="p-4 rounded-xl border border-border bg-card/60 space-y-3 text-xs text-muted-foreground">
          <h3 class="font-semibold text-foreground uppercase tracking-wider">About the Author</h3>
          <p>
            <strong class="text-foreground">{AUTHOR_NAME}</strong> writes about Python development, unit testing, software architecture, and accessibility.
          </p>
          <a href="/about" class="text-primary hover:underline font-medium inline-block">
            Learn more about Ashlynn &rarr;
          </a>
        </div>
      </aside>
    </div>

    <!-- Post Footer Author Card -->
    <footer class="mt-16 pt-8 border-t border-border/80">
      <div class="p-6 sm:p-8 rounded-2xl border border-border bg-muted/30 flex flex-col sm:flex-row items-center sm:items-start gap-5">
        <div class="w-14 h-14 rounded-full bg-primary text-primary-foreground font-bold font-mono text-xl flex items-center justify-center shrink-0 shadow-sm">
          AA
        </div>
        <div class="space-y-2 text-center sm:text-left">
          <h3 class="text-lg font-bold text-foreground">Written by {AUTHOR_NAME}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Software developer, author, and builder. Sharing technical lessons learned from building tools like LoreBinders, ProsePal, and Ebook2Text, and navigating life as a programmer with dyslexia.
          </p>
          <div class="flex items-center justify-center sm:justify-start gap-4 pt-1 text-xs">
            <a href="/about" class="text-primary hover:underline font-medium">Read Bio</a>
            <span class="text-muted-foreground">•</span>
            <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground">GitHub</a>
            <span class="text-muted-foreground">•</span>
            <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground">LinkedIn</a>
          </div>
        </div>
      </div>
    </footer>
  </article>

  <!-- Client-side copy code helper -->
  <CopyCodeButton />
</BaseLayout>
