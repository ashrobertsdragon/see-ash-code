---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedPosts, getAllTags } from '../utils/posts';
import { getCollection } from 'astro:content';
import { AUTHOR_NAME } from '../consts';

const publishedPosts = await getPublishedPosts();
const recentPosts = publishedPosts.slice(0, 4);
const tags = await getAllTags();

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title="Home" description="Personal portfolio and technical blog of Ashlynn Antrobus — Python, testing, software architecture, and accessibility.">
  <!-- Hero Section -->
  <section class="py-12 md:py-16 space-y-6 border-b border-border/60">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary border border-primary/20">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Building open source & writing software
    </div>

    <div class="space-y-4 max-w-3xl">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-foreground leading-[1.1]">
        Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-indigo-500">{AUTHOR_NAME}</span>.
      </h1>
      <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed">
        I am a software developer and indie author writing about <strong class="text-foreground">Python</strong>,
        <strong class="text-foreground">DevOps tooling</strong>, <strong class="text-foreground">unit testing</strong>, and
        <strong class="text-foreground">accessibility in code</strong>.
      </p>
    </div>

    <!-- Quick action buttons -->
    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold bg-primary text-primary-foreground hover:opacity-90 transition-opacity shadow-sm"
      >
        Read the Blog &rarr;
      </a>
      <a
        href="/projects"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold border border-border bg-card hover:bg-muted text-foreground transition-colors"
      >
        View Projects
      </a>
      <a
        href="/about"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
      >
        About Me
      </a>
    </div>

    <!-- Tech Stack / Skills Bar -->
    <div class="pt-6 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-muted-foreground font-medium mr-2">Focus areas:</span>
      {['Python', 'Architecture', 'Pytest / Unit Testing', 'DevOps & CI/CD', 'Accessibility / Dyslexia', 'TypeScript'].map((skill) => (
        <span class="px-2.5 py-1 rounded-md bg-muted text-muted-foreground font-mono text-[11px] border border-border/40">
          {skill}
        </span>
      ))}
    </div>
  </section>

  <!-- Featured / Recent Posts Section -->
  <section class="py-14 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Recent Articles</h2>
        <p class="text-sm text-muted-foreground mt-1">Deep dives into Python quirks, architecture refactors, and developer journeys.</p>
      </div>
      <a href="/blog" class="text-sm font-medium text-primary hover:underline hidden sm:inline-flex items-center gap-1">
        All Articles ({publishedPosts.length}) &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {recentPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>

    <div class="sm:hidden pt-2 text-center">
      <a href="/blog" class="text-sm font-medium text-primary hover:underline">
        Browse all {publishedPosts.length} articles &rarr;
      </a>
    </div>
  </section>

  <!-- Highlighted Projects Section -->
  <section class="py-14 space-y-6 border-t border-border/60">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Featured Projects</h2>
        <p class="text-sm text-muted-foreground mt-1">Author workspaces, document normalizers, and modular Python tools.</p>
      </div>
      <a href="/projects" class="text-sm font-medium text-primary hover:underline hidden sm:inline-flex items-center gap-1">
        All Projects &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- Explore by Topic / Tags -->
  {
    tags.length > 0 && (
      <section class="py-12 border-t border-border/60 space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-foreground">Explore by Topic</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map(({ tag, slug, count }) => (
            <a
              href={`/tags/${slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border bg-card hover:bg-primary/10 hover:border-primary/40 text-xs font-medium text-muted-foreground hover:text-primary transition-all"
            >
              <span>#{tag}</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-muted text-foreground font-mono">
                {count}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
