---
import '../styles/index.css';
import ThemeScript from './ThemeScript.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR_NAME, SITE_URL } from '../consts';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
  ogType?: 'website' | 'article';
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = '/images/Screenshot-2024-06-11-092921.png',
  articleDate,
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);
const formattedTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const socialImageURL = new URL(image, Astro.site || SITE_URL);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />

<!-- Theme Script to Prevent FOUC -->
<ThemeScript />

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<meta name="author" content={AUTHOR_NAME} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
{articleDate && <meta property="article:published_time" content={articleDate} />}

<!-- Twitter Card -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<!-- RSS Feed Auto-discovery -->
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
